# ── MT5 credentials (leave blank if MT5 is already open and logged in) ────────
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=

# ── Instrument ─────────────────────────────────────────────────────────────────
SYMBOL=
TIMEFRAME=D1

# ── Scanner interval ───────────────────────────────────────────────────────────
SCAN_INTERVAL=60

# ── Execution Mode ─────────────────────────────────────────────────────────────
MANUAL_CONFIRM=true

# ── Risk Management ────────────────────────────────────────────────────────────
RISK_PERCENT=1.0
MAX_POSITION_SIZE=

# ── Strategy Parameters ────────────────────────────────────────────────────────
# Size of move from last base (20-day MA touch)
SMALLCAP_MOVE_PCT=200       # small-cap threshold %
MIDCAP_MOVE_PCT=100         # mid-cap threshold %
LARGECAP_MOVE_PCT=50        # large-cap threshold %

# Exhaustion day filters
VWAP_PERIOD=D1              # VWAP reset period
MAX_ENTRY_DAYS=2            # window to act after exhaustion signal (days)

# Entry / Stop
ENTRY_TYPE=vwap_rejection   # break_structure | vwap_loss | vwap_rejection
STOP_TYPE=day_high          # day_high | recent_lower_high

# ── Trade Settings ─────────────────────────────────────────────────────────────
MAGIC_NUMBER=20260419
SLIPPAGE=20
CLOSE_EOD=true              # always close before end of day
